# 任意。未設定/空なら /api と /auth/social の相対URL（開発時はVite proxy）を使う。
# 本番Pagesのビルド環境: VITE_API_ORIGIN=https://api.hibilio.com
# originのみ指定（/apiなどのpath、query、fragment、認証情報は不可）。
# VITE_変数はブラウザへ公開されるため、秘密鍵・API token・passwordは設定しない。
VITE_API_ORIGIN=

# Google AdSense（審査・広告ユニット作成後に設定）
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_FEED_SLOT=
